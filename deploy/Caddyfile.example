# PROPOSAL ONLY. The edge owner supplies a DNS hostname under their control and
# connects the existing edge container to estagent-assistant-edge.
# Do not replace the shared Caddyfile or restart the shared stack with this file.
{$ESTAGENT_API_HOST} {
    @assistant path /api/assistant/*
    handle @assistant {
        # Preserve the /api/assistant prefix and original Origin/Set-Cookie.
        reverse_proxy estagent-assistant-api:5180 {
            transport http {
                dial_timeout 5s
                response_header_timeout 40s
            }
        }
    }
    handle {
        respond 404
    }
}
