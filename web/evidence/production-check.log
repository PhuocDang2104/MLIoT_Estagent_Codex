  await page.setViewportSize({ width: 1440, height: 1000 });
  await page.goto('https://estagent-weld.vercel.app/');
  await page.getByRole('link', { name: 'Trải nghiệm ngay', exact: true }).first().click();
  await page.waitForLoadState('load');
