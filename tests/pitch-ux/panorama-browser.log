await (async page=>{
 const errors=[];page.on('pageerror',e=>errors.push(e.message));await page.emulateMedia({reducedMotion:'no-preference'});await page.goto('https://estagent.duckdns.org/index.html');await page.locator('#hero-panorama').waitFor({state:'visible'});await page.locator('[data-lang="en"]').click();
 const pixels=()=>page.locator('#hero-panorama').evaluate(c=>c.toDataURL());const before=await pixels();await page.waitForTimeout(600);if(before===await pixels())throw Error('No real rotation');
 await page.locator('#hero-rotation').click();const paused=await pixels();await page.waitForTimeout(300);if(paused!==await pixels())throw Error('Pause failed');
 const sizes=[];for(const [width,height] of [[1440,1000],[390,844],[320,740]]){await page.setViewportSize({width,height});const box=await page.locator('.pitch-hero').boundingBox();if(box.x!==0||box.y!==0||box.width!==width||box.height!==height)throw Error('Not fullscreen '+JSON.stringify(box));if(!await page.evaluate(()=>document.documentElement.scrollWidth===innerWidth))throw Error('Overflow');sizes.push(box);await page.screenshot({path:'/private/tmp/pitch-panorama-'+width+'.png'});}
 await page.locator('#hero-rotation').click();await page.emulateMedia({reducedMotion:'reduce'});const still=await pixels();await page.waitForTimeout(300);if(still!==await pixels())throw Error('Reduced motion');
 const hrefs=await page.locator('.hero-actions a').evaluateAll(es=>es.map(e=>e.getAttribute('href')));if(hrefs.join('|')!=='/demos/zind-house-000|/creator.html')throw Error('CTA links');if(errors.length)throw Error(errors.join(';'));return {pass:true,fullscreen:sizes,realPixelRotation:true,pause:true,reducedMotion:true,hrefs,errors};
})(page);
