{
  "$defs": {
    "Audio": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "unavailable",
          "enum": [
            "unavailable",
            "partial",
            "ready"
          ],
          "title": "Status",
          "type": "string"
        },
        "narration": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SceneNarration"
              },
              "maxItems": 20,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narration"
        },
        "music": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioTrack"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "default": "none",
          "enum": [
            "none",
            "user_uploaded"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "title": "Audio",
      "type": "object"
    },
    "AudioTrack": {
      "additionalProperties": false,
      "properties": {
        "source_label": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Source Label",
          "type": "string"
        },
        "rights": {
          "enum": [
            "owned",
            "licensed"
          ],
          "title": "Rights",
          "type": "string"
        },
        "rights_note": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Rights Note",
          "type": "string"
        },
        "asset_id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Asset Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "content_type": {
          "const": "audio/wav",
          "default": "audio/wav",
          "title": "Content Type",
          "type": "string"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 180,
          "title": "Duration Seconds",
          "type": "number"
        },
        "channels": {
          "enum": [
            1,
            2
          ],
          "title": "Channels",
          "type": "integer"
        },
        "sample_rate": {
          "maximum": 48000,
          "minimum": 8000,
          "title": "Sample Rate",
          "type": "integer"
        },
        "sample_width": {
          "const": 2,
          "default": 2,
          "title": "Sample Width",
          "type": "integer"
        }
      },
      "required": [
        "source_label",
        "rights",
        "rights_note",
        "asset_id",
        "url",
        "duration_seconds",
        "channels",
        "sample_rate"
      ],
      "title": "AudioTrack",
      "type": "object"
    },
    "SceneNarration": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Scene Id",
          "type": "string"
        },
        "locale": {
          "enum": [
            "en",
            "vi"
          ],
          "title": "Locale",
          "type": "string"
        },
        "transcript": {
          "default": "",
          "maxLength": 2000,
          "title": "Transcript",
          "type": "string"
        },
        "track": {
          "$ref": "#/$defs/AudioTrack"
        }
      },
      "required": [
        "scene_id",
        "locale",
        "track"
      ],
      "title": "SceneNarration",
      "type": "object"
    },
    "SceneView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Id",
          "type": "string"
        },
        "asset_id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Asset Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "projection": {
          "default": "photo",
          "enum": [
            "photo",
            "cylindrical"
          ],
          "title": "Projection",
          "type": "string"
        },
        "coverage_degrees": {
          "anyOf": [
            {
              "maximum": 360,
              "minimum": 30,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Degrees"
        },
        "coverage_source": {
          "default": "unknown",
          "enum": [
            "unknown",
            "user_provisional",
            "user_calibrated"
          ],
          "title": "Coverage Source",
          "type": "string"
        },
        "image_url": {
          "title": "Image Url",
          "type": "string"
        },
        "thumbnail_url": {
          "title": "Thumbnail Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "asset_id",
        "name",
        "image_url",
        "thumbnail_url"
      ],
      "title": "SceneView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "checkpoint-tour-v1",
      "default": "checkpoint-tour-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-f0-9]{32}$",
      "title": "Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ],
      "title": "Status",
      "type": "string"
    },
    "title": {
      "maxLength": 150,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "locale": {
      "enum": [
        "en",
        "vi"
      ],
      "title": "Locale",
      "type": "string"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/SceneView"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "start_scene_id": {
      "title": "Start Scene Id",
      "type": "string"
    },
    "audio": {
      "$ref": "#/$defs/Audio"
    },
    "credits": {
      "items": {
        "type": "string"
      },
      "title": "Credits",
      "type": "array"
    }
  },
  "required": [
    "id",
    "revision",
    "status",
    "title",
    "locale",
    "scenes",
    "start_scene_id",
    "credits"
  ],
  "title": "Manifest",
  "type": "object"
}
