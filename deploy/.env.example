# Deployment placeholders only. Store the real file outside the checkout, mode 0600.
# Image tag must identify the accepted source commit; do not use latest.
ASSISTANT_IMAGE=estagent-assistant:REPLACE_COMMIT
OPENAI_API_KEY=
# Explicit no-paid-API preview only: set 1 with an empty key. Default 0 requires a key.
ESTAGENT_KEYLESS_PREVIEW=0
# Guards may stay disabled only with an empty API key. A live key requires 1 and all AI bounds.
# Attempt limits are not a USD cap; Realtime limits SDP admission, not stream duration.
API_LIMITS_ENABLED=0
API_LIMITS_DB=/data/api-limits.sqlite
API_LIMITS_AI_REQUESTS=6
API_LIMITS_AI_WINDOW_SECONDS=60
API_LIMITS_AI_CONCURRENCY=1
API_LIMITS_AI_ATTEMPTS=50
API_LIMITS_AI_ATTEMPT_WINDOW_SECONDS=3600
API_LIMITS_UPLOAD_REQUESTS=24
API_LIMITS_UPLOAD_WINDOW_SECONDS=60
API_LIMITS_UPLOAD_CONCURRENCY=1
# Explicit upload admission for this application's dedicated data volume.
# Includes logical SQLite/WAL/backup file sizes; not an OS-enforced filesystem quota.
STORAGE_LIMITS_ENABLED=0
STORAGE_LIMITS_ROOT=/data
STORAGE_LIMITS_MAX_BYTES=536870912
STORAGE_LIMITS_MIN_FREE_BYTES=1073741824
# These are the current assistant defaults, not verified model access/quota.
OPENAI_MODEL_TEXT=gpt-6.1-sol
OPENAI_MODEL_VISION=gpt-6.1-terra
OPENAI_MODEL_MODELING=gpt-6-astra
OPENAI_REASONING_MODELING=high
OPENAI_REASONING_TEXT=low
OPENAI_REASONING_VISION=low
OPENAI_MODEL_TTS=gpt-4o-mini-tts
# STUDIO_DATA_DIR=/private/path/studio
# Optional operator-controlled internal worker; when set it takes precedence over local Blender.
# Must implement docs/STUDIO-RUNTIME.md; no model-selected URLs or arbitrary MCP tools.
STUDIO_GEOMETRY_URL=
STUDIO_GEOMETRY_TOKEN=
# Build the optional image with --build-arg WITH_BLENDER=1 before enabling Blender.
STUDIO_GEOMETRY=auto
STUDIO_BLENDER_TIMEOUT=180
# Cumulative provider attempts across restarts; operator raises the cap explicitly.
# This covers Studio planning/editing/TTS/Q&A, not the legacy APIs or account billing.
STUDIO_API_CALL_LIMIT=40
# Qualify resource limits on the target host when using that image:
# ESTAGENT_MEMORY_LIMIT=4g
# ESTAGENT_CPU_LIMIT=2.0
OPENAI_MODEL_REALTIME=gpt-realtime-2.1
OPENAI_MODEL_TRANSCRIBE=gpt-transcribe
# Browser origin, NOT the backend upstream hostname. No trailing slash.
ASSISTANT_ORIGIN=https://estagent.duckdns.org
# Current provisional policy from docs/ASSISTANT.md; owner must confirm before prod.
ASSISTANT_REQUIRED_FIELDS=address,area,bedrooms

# Backend only. Dedicated private MinIO network must exist before compose up.
# Local remains supported; for MinIO all fields below must be explicitly set.
MEDIA_STORAGE_BACKEND=local
MINIO_ENDPOINT=estagent-minio:9000
MINIO_SECURE=0
MINIO_BUCKET=estagent-media
MINIO_ACCESS_KEY=REPLACE_APP_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_APP_SECRET_KEY

# Optional pinned cached-house catalog. Real data/bundle remains outside Git.
DEMO_CATALOG_PATH=
DEMO_CATALOG_DIR=/opt/estagent/runtime/demo-cache

# TTS generation stays disabled until an explicit additional spend allowance.
NARRATION_ENABLED=0
OPENAI_TTS_API_KEY=
NARRATION_MAX_SCRIPT_CHARS=1200
NARRATION_QUEUE_SIZE=4
NARRATION_ATTEMPTS=
NARRATION_CHARACTERS=
NARRATION_WINDOW_SECONDS=
NARRATION_CACHE_SECONDS=3600
NARRATION_TIMEOUT_SECONDS=30

# Enable after native FFmpeg + private MinIO integration smoke.
VIDEO_EXPORT_ENABLED=0
VIDEO_EXPORT_RENDERER=ffmpeg
VIDEO_EXPORT_LOCAL_QA=0
# Optional read-only Seoul sample (private MinIO assets, separate pinned catalog).
SEOUL_CATALOG_PATH=
SEOUL_CATALOG_DIR=/opt/estagent/runtime/seoul-cache
