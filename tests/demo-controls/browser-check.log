 await page.locator('#demo-guide .guide-toggle').click();if(!await page.locator('#demo-guide>audio').evaluate(a=>a.paused))throw Error('Pause failed');
 const sizes=[];
 for(const [width,height] of [[1440,1000],[390,844],[320,740]]){
  await page.setViewportSize({width,height});const box=await page.locator('#demo-guide').boundingBox();if(box.x<0||box.x+box.width>width+.5||box.y+box.height>height||box.y<height-120)throw Error('Transport bounds '+JSON.stringify(box));
  if(await page.locator('#demo-guide>button').count()!==1)throw Error('Multiple playback buttons');if(await page.locator('#demo-intro>summary').isVisible()||await page.locator('#demo-source>summary').isVisible())throw Error('Secondary clutter');
  await page.screenshot({path:'/private/tmp/demo-controls-'+width+'.png'});await page.locator('#demo-settings>summary').click();const settings=await page.locator('.guide-settings-panel').boundingBox();if(settings.x<0||settings.x+settings.width>width+.5||settings.y<0)throw Error('Settings overflow');await page.keyboard.press('Escape');if(!await page.locator('#panoMode').evaluate(e=>e.classList.contains('active')))throw Error('Closing settings changed camera mode');sizes.push(box);
 }
 if(errors.length)throw Error(errors.join(';'));return {pass:true,entry,realPlaybackAfterEntryOrOneGesture:true,pause:true,singleButton:true,secondaryCollapsed:true,sizes,errors};
}
)(page);
