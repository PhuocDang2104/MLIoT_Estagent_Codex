# FUTURE BACKEND INTEGRATION ONLY. Replace only the existing Estagent site block
# after backend health/budget checks, and connect the edge to the backend network.
# The current production site is deploy/estagent.duckdns.Caddyfile (frontend only).
# Do not replace the shared Caddyfile or restart other applications.
estagent.duckdns.org {
    @assistant path /api/assistant/* /api/tours/* /api/studio/* /api/studio-tours/*
    handle @assistant {
        # Preserve the /api/assistant prefix and original Origin/Set-Cookie.
        reverse_proxy estagent-assistant-api:5180 {
            transport http {
                dial_timeout 5s
                response_header_timeout 40s
            }
        }
    }
    handle {
        reverse_proxy estagent-web:8080
    }
}
