# Load on the backend. Only explicitly public browser credentials may reach web/.
# Copy to .env.local; never expose server keys. See docs/INTEGRATIONS.md.
# Required: use your existing OpenAI project key for chat + transcription + voice.
# Create/manage: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional until the Maps integration is implemented. Not consumed by the app yet.
# Create/manage: https://console.apify.com/settings/integrations
APIFY_API_TOKEN=

# Local LangGraph and SQLite do not require additional API keys.
# Model IDs below are configuration values, not secrets.
OPENAI_MODEL_TEXT=gpt-6.1-sol
OPENAI_MODEL_VISION=gpt-6.1-sol
OPENAI_MODEL_TTS=gpt-4o-mini-tts
# STUDIO_DATA_DIR=/private/path/studio
OPENAI_MODEL_REALTIME=gpt-realtime-2.1
OPENAI_MODEL_TRANSCRIBE=gpt-transcribe
ASSISTANT_ORIGIN=http://127.0.0.1:5180
# Draft policy; configurable without changing the graph.
ASSISTANT_REQUIRED_FIELDS=address,area,bedrooms
# Optional: set an absolute path for SQLite checkpoints; keep outside web/.
# ASSISTANT_DB=/private/path/checkpoints.sqlite

# Reserved integrations below: configuration only, not wired into the app yet.
# P0 Maps: enable Places API (New), Geocoding and Routes for the server key.
# https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_SERVER_KEY=
# Public browser key: restrict by HTTP referrer and Maps JavaScript API.
# Only needed when embedding a Google map; do not reuse the server key.
GOOGLE_MAPS_BROWSER_KEY=

# P0 persistence: dedicated Estagent Supabase self-host deployment on the VM.
# MVP: database/storage through backend only; no user authentication.
# Publishable/anon keys are not needed for this backend-only storage flow.
# Do not reuse another project's Supabase stack or credentials.
# Modern keys below; legacy deployments can use the commented pair instead.
# https://supabase.com/docs/guides/self-hosting/self-hosted-auth-keys
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=estagent-assets
# Optional migration from the current SQLite LangGraph checkpoint store.
DATABASE_URL=
# Optional local worker queue; a connection URL, not a separate SaaS key.
REDIS_URL=

# Conditional GPU cloud: requires deploying a custom PanSplat worker first.
# https://docs.runpod.io/get-started/credentials
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Deferred beyond MVP: no auth or email now; leave these fields empty.
# Future auth/transactional email requires a verified sending domain.
# https://resend.com/docs/send-with-supabase-smtp
RESEND_API_KEY=
EMAIL_FROM=

# Optional LangGraph observability. Tracing sends data to LangSmith; off by default.
# https://docs.langchain.com/langsmith/observability-quickstart
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=estagent

# Local checkpoint tours: images + SQLite, separate from assistant checkpoints.
# Default: directory 'tours' next to ASSISTANT_DB, gitignored under projects/*/work/.
# TOUR_DATA_DIR=/private/path/estagent-tours
# Optional local script port; ASSISTANT_ORIGIN must match when set explicitly.
ESTAGENT_PORT=5180

# Keyless preview may leave guards disabled; a configured OpenAI key requires them.
# Attempt allowance is not a dollar budget or a Realtime stream-duration cap.
API_LIMITS_ENABLED=0
# Dedicated persistent SQLite ledger, separate from assistant/tour/Studio databases.
API_LIMITS_DB=/private/path/estagent/api-limits.sqlite
STUDIO_GEOMETRY_URL=
STUDIO_GEOMETRY_TOKEN=
API_LIMITS_AI_REQUESTS=6
API_LIMITS_AI_WINDOW_SECONDS=60
API_LIMITS_AI_CONCURRENCY=1
API_LIMITS_AI_ATTEMPTS=50
API_LIMITS_AI_ATTEMPT_WINDOW_SECONDS=3600
API_LIMITS_UPLOAD_REQUESTS=6
API_LIMITS_UPLOAD_WINDOW_SECONDS=60
API_LIMITS_UPLOAD_CONCURRENCY=1

# Upload admission on a dedicated application root, including all three data stores.
STORAGE_LIMITS_ENABLED=0
STORAGE_LIMITS_ROOT=/private/path/estagent
STORAGE_LIMITS_MAX_BYTES=536870912
STORAGE_LIMITS_MIN_FREE_BYTES=1073741824
