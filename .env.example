# Backend only. Copy to .env.local; never put keys in browser code.
OPENAI_API_KEY=
OPENAI_MODEL_TEXT=gpt-6.1-sol
OPENAI_MODEL_REALTIME=gpt-realtime-2.1
OPENAI_MODEL_TRANSCRIBE=gpt-transcribe
ASSISTANT_ORIGIN=http://127.0.0.1:5180
# Draft policy; configurable without changing the graph.
ASSISTANT_REQUIRED_FIELDS=address,area,bedrooms
# Optional: set an absolute path for SQLite checkpoints; keep outside web/.
# ASSISTANT_DB=/private/path/checkpoints.sqlite
