# Deployment placeholders only. Store the real file outside the checkout, mode 0600.
# Image tag must identify the accepted source commit; do not use latest.
ASSISTANT_IMAGE=estagent-assistant:REPLACE_COMMIT
OPENAI_API_KEY=
# Explicit no-paid-API preview only: set 1 with an empty key. Default 0 requires a key.
ESTAGENT_KEYLESS_PREVIEW=0
# These are the current assistant defaults, not verified model access/quota.
OPENAI_MODEL_TEXT=gpt-6.1-sol
OPENAI_MODEL_VISION=gpt-6.1-sol
OPENAI_MODEL_TTS=gpt-4o-mini-tts
# STUDIO_DATA_DIR=/private/path/studio
# Build the optional image with --build-arg WITH_BLENDER=1 before enabling Blender.
STUDIO_GEOMETRY=auto
STUDIO_BLENDER_TIMEOUT=180
# Qualify resource limits on the target host when using that image:
# ESTAGENT_MEMORY_LIMIT=4g
# ESTAGENT_CPU_LIMIT=2.0
OPENAI_MODEL_REALTIME=gpt-realtime-2.1
OPENAI_MODEL_TRANSCRIBE=gpt-transcribe
# Browser origin, NOT the backend upstream hostname. No trailing slash.
ASSISTANT_ORIGIN=https://estagent.duckdns.org
# Current provisional policy from docs/ASSISTANT.md; owner must confirm before prod.
ASSISTANT_REQUIRED_FIELDS=address,area,bedrooms
