 await page.goto('https://estagent.duckdns.org/creator.html');await page.locator('#drop-zone').waitFor();await page.locator('[data-lang="en"]').click();
 const picker=page.waitForEvent('filechooser');await page.locator('#drop-zone').focus();await page.keyboard.press('Enter');await (await picker).setFiles('/tmp/pitch-synthetic.png');await page.locator('#attachments .attachment').waitFor();
 for(const width of [1440,390,320]){await page.setViewportSize({width,height:900});if(!await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth))throw Error('Creator overflow '+width);await page.screenshot({path:'/private/tmp/pitch-creator-'+width+'.png'});}
 if(await page.locator('#connection').isVisible())throw Error('Dev badge visible');if(errors.length)throw Error(errors.join(';'));
 return {pass:true,viewports:checks,ENVI:true,twoCTA:true,keyboardFilePicker:true,attachmentPreview:true,emptyDraftsHidden:!await page.locator('#saved-drafts').isVisible(),errors,heroLoaded:await page.locator('#demo-hero').count()};
})(page);
